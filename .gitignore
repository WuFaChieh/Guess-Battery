# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-isolation
*.local

# Environment variables — contains Supabase keys / webhook URLs, never commit
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# iOS native project (Capacitor) — the Xcode project itself is committed,
# but these are per-machine/per-user build artifacts, not source.
ios/App/Pods
ios/App/build
ios/App/DerivedData
ios/**/xcuserdata
ios/**/*.xcuserstate
ios/App/App/public
